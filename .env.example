# Configuration for the Engineering Tools app.
# Copy to .env and fill in. Entra values come from the app registration,
# the tunnel token from Cloudflare. Never commit the filled-in file.

CLOUDFLARE_TUNNEL_TOKEN=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CALLBACK_URL=
SESSION_SECRET=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Local development only -------------------------------------------------
# Set AUTH_DEV_BYPASS=1 to skip Entra entirely and sign in as AUTH_DEV_USER.
# Leave the AZURE_* values empty when you do; you do not need a client secret.
# The app refuses to start with this flag if CLOUDFLARE_TUNNEL_TOKEN is set or
# NODE_ENV=production, so it cannot be switched on by accident on a server.
AUTH_DEV_BYPASS=
AUTH_DEV_USER=
