<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catenary Calculator</title>
  <link rel="stylesheet" href="nseastyle.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,300;0,400;0,700;0,900;1,700&display=swap" rel="stylesheet">
</head>
<body>
<header>
  <div class="brand-row">
    <div class="brand-left">
      <div class="brand-logo-wrap"><img class="brand-logo" src="data:image/svg+xml;base64," alt="N-Sea logo"></div>
      <div>
        <div class="project-label">Cable Engineering Tools</div>
        <div class="project-sub-label"><a href="/">Back to dashboard</a></div>
      </div>
    </div>
    <div class="brand-title">
      <div>
        <h1>Cable Catenary Calculator</h1>
        <p>Catenary shape, length, and bottom tension</p>
      </div>
    </div>
  </div>
</header>

<main>
  <section class="panel inputs">
    <form method="post" action="">
    <div class="input-tabs" role="tablist" aria-label="Catenary input tabs">
      <button class="tab-button" id="projectTab" type="button" data-tab-target="projectInputPanel" role="tab" aria-controls="projectInputPanel" aria-selected="false">Project Input</button>
      <button class="tab-button is-active" id="engineeringTab" type="button" data-tab-target="engineeringInputPanel" role="tab" aria-controls="engineeringInputPanel" aria-selected="true">Input Values</button>
    </div>

    <div class="tab-panel" id="projectInputPanel" role="tabpanel" aria-labelledby="projectTab">
      <h2>Project Input</h2>
      <div class="field">
        <label for="projectNameInput">Project Name</label>
        <input id="projectNameInput" name="projectName" type="text">
      </div>
      <div class="field">
        <label for="projectNumberInput">Project Number</label>
        <input id="projectNumberInput" name="projectNumber" type="text">
      </div>
      <div class="field">
        <label for="revisionInput">Revision</label>
        <input id="revisionInput" name="revision" type="text">
      </div>
      <div class="field">
        <label for="authorInput">Author</label>
        <input id="authorInput" name="author" type="text">
      </div>
    </div>

    <div class="tab-panel is-active" id="engineeringInputPanel" role="tabpanel" aria-labelledby="engineeringTab">
    <span class="section-kicker">Engineering inputs</span><h2>Input values</h2>
    <div id="error" class="error"<% if (reportError) { %> style="display:block"<% } %>><%= reportError || '' %></div>

    <div class="field">
      <label for="wetWeight">Wet weight of cable</label>
      <div class="input-wrap"><input id="wetWeight" name="wetWeight" type="number" min="0.1" step="0.1" value="37"><span class="unit">kg/m</span></div>
    </div>
    <div class="field">
      <label for="minRadius">Minimum bending radius</label>
      <div class="input-wrap"><input id="minRadius" name="minRadius" type="number" min="0" step="0.1" value="3"><span class="unit">m</span></div>
    </div>
    <div class="field">
      <label for="maxTension">Maximum cable tension</label>
      <div class="input-wrap"><input id="maxTension" name="maxTension" type="number" min="0.1" step="0.1" value="20.7"><span class="unit">t</span></div>
      <div class="hint">Used as a safety limit only; it does not change the profile.</div>
    </div>
    <div class="field">
      <label for="layback">Layback to TDP</label>
      <div class="input-wrap"><input id="layback" name="layback" type="text" value="25" placeholder="e.g. 25 or 20;30;35"><span class="unit">m</span></div>
      <div class="hint">Separate multiple laybacks with semicolons only.</div>
    </div>
    <div class="field">
      <label for="waterDepthLat">Water depth from LAT</label>
      <div class="input-wrap"><input id="waterDepthLat" name="waterDepthLat" type="text" value="30" placeholder="e.g. 30 or 25;30;35"><span class="unit">m</span></div>
      <div class="hint">Separate multiple water depths with semicolons only.</div>
    </div>
    <div class="field">
      <label for="waterLevel">Water level</label>
      <div class="input-wrap"><input id="waterLevel" name="waterLevel" type="text" value="0" placeholder="e.g. 0 or -1;0;1.5"><span class="unit">m</span></div>
      <div class="hint">Separate multiple water levels with semicolons only.</div>
    </div>
    <div class="field">
      <label for="chuteHeight">Waterline to chute</label>
      <div class="input-wrap"><input id="chuteHeight" name="chuteHeight" type="number" min="0" step="0.1" value="3"><span class="unit">m</span></div>
      <div class="hint">Total vertical distance = LAT depth + water level + chute height.</div>
    </div>

    <div class="buttons">
      <button class="primary" id="generateReportBtn" type="button">Generate Report PDF</button>
      <button class="secondary full-row" id="saveProjectBtn" type="button">Save Project</button>
      <button class="secondary full-row" id="loadProjectBtn" type="button">Load Project</button>
      <a class="button-link manual-action full-row" href="https://nseagroupbv.sharepoint.com/sites/SubseaCablesDept/_layouts/15/guestaccess.aspx?share=IQC5BTsuk5Y5SbFEeXvEEdZTATLHSfqZPgT9lGvaUqGDfVM&amp;e=ZBuOIE" target="_blank" rel="noopener">Manual</a>
      <button class="danger" id="undoBtn" type="button">Undo</button>
      <button class="action" id="redoBtn" type="button">Redo</button>
      <input id="projectFileInput" type="file" accept=".csv,text/csv" hidden>
    </div>
    </div>

    <div class="note">
      This is a static ideal catenary calculation. It does not include vessel motion, current, hydrodynamic drag, cable stiffness, seabed interaction, dynamic amplification or installation transients.
    </div>
    </form>
  </section>

  <section class="panel outputs">
    <span class="section-kicker">Calculated profile</span><h2>Calculation result</h2>
    <div class="summary">
      <div class="metric"><div class="name">Bottom tension</div><div class="value" id="bottomTension">-</div></div>
      <div class="metric"><div class="name">Onboard tension</div><div class="value" id="onboardTension">-</div></div>
      <div class="metric"><div class="name">Catenary length</div><div class="value" id="length">-</div></div>
      <div class="metric"><div class="name">Departure angle</div><div class="value" id="angle">-</div></div>
    </div>
    <div class="checks">
      <span id="radiusCheck" class="pill">Bend radius: -</span>
      <span id="tensionCheck" class="pill">Tension limit: -</span>
    </div>
    <div class="canvas-wrap"><canvas id="chart"></canvas></div>
    <div class="table-wrap">
      <table class="result-table">
        <thead id="resultTableHead"><tr><th>Parameter</th><th>Value</th></tr></thead>
        <tbody id="resultTable"></tbody>
      </table>
    </div>
  </section>
</main>
<footer>
  <div class="footer-inner">
    <span class="footer-brand">N-Sea Engineering Tools</span> - Built by Rida. Still evolving, already surprisingly useful. Found a bug or have an idea to make it even better?
    <a class="footer-contact" href="<%= mailtoLink %>">Drop me a line and let me know.</a>
  </div>
</footer>

<script>
(() => {
  'use strict';
  const G = 9.81;
  const TONNE_FORCE_N = 9800;
  const DEGREE = String.fromCharCode(176);
  const defaults = { wetWeight:37, minRadius:3, maxTension:20.7, chuteHeight:3 };
  const textDefaults = { layback:'25', waterDepthLat:'30', waterLevel:'0' };
  const projectDefaults = { projectNameInput:'', projectNumberInput:'', revisionInput:'', authorInput:'' };
  let latest = null;
  let history = [];
  let historyIndex = -1;

  const $ = id => document.getElementById(id);
  const numericEngineeringKeys = Object.keys(defaults);
  const engineeringKeys = [...numericEngineeringKeys, ...Object.keys(textDefaults)];
  const projectKeys = Object.keys(projectDefaults);
  const inputKeys = [...engineeringKeys, ...projectKeys];
  const inputs = engineeringKeys.map($);
  const projectInputs = projectKeys.map($);

  function readInputs() {
    const v = {};
    for (const key of numericEngineeringKeys) v[key] = Number($(key).value);
    for (const key of Object.keys(textDefaults)) v[key] = $(key).value.trim();
    if (!Number.isFinite(v.wetWeight) || v.wetWeight <= 0) throw new Error('Wet cable weight must be greater than zero.');
    if (!Number.isFinite(v.minRadius) || v.minRadius < 0) throw new Error('Minimum bending radius cannot be negative.');
    if (!Number.isFinite(v.maxTension) || v.maxTension <= 0) throw new Error('Maximum cable tension must be greater than zero.');
    if (!Number.isFinite(v.chuteHeight) || v.chuteHeight < 0) throw new Error('Depth values cannot be negative.');
    return v;
  }

  function uniqueValues(values) {
    const unique = new Map();
    for (const value of values) {
      const key = value.toFixed(3);
      if (!unique.has(key)) unique.set(key, value);
    }
    return [...unique.values()];
  }

  function parsePositiveValues(text, label, emptyLabel) {
    const parts = String(text || '').split(';')
      .map(part => part.trim())
      .filter(Boolean);
    if (parts.length > 50) throw new Error(`${label} must contain at most 50 values.`);
    const values = parts
      .map(part => {
        const value = Number(part.replace(',', '.'));
        if (!Number.isFinite(value)) throw new Error(`${label} must be numbers separated by semicolons only.`);
        if (value <= 0) throw new Error(`${label} must be greater than zero.`);
        return value;
      });
    if (!values.length) throw new Error(`Enter at least one ${emptyLabel} value.`);
    return uniqueValues(values);
  }

  function parseNumericValues(text, label, emptyLabel) {
    const parts = String(text || '').split(';')
      .map(part => part.trim())
      .filter(Boolean);
    if (parts.length > 50) throw new Error(`${label} must contain at most 50 values.`);
    const values = parts
      .map(part => {
        const value = Number(part.replace(',', '.'));
        if (!Number.isFinite(value)) throw new Error(`${label} must be numbers separated by semicolons only. Use either a comma or a dot for decimals.`);
        return value;
      });
    if (!values.length) throw new Error(`Enter at least one ${emptyLabel} value.`);
    return uniqueValues(values);
  }

  function safeCosh(x) { if (x > 700) return Infinity; return Math.cosh(x); }

  function calculateCatenaryProfile(v, layback, waterDepthLat, waterLevel) {
    const waterDepth = waterDepthLat + waterLevel;
    if (waterDepth <= 0) throw new Error('Water depth from LAT plus water level must be greater than zero.');
    const totalDepth = waterDepth + v.chuteHeight;
    const w = v.wetWeight * G;
    const maxTensionN = v.maxTension * 1000 * G;
    const f = a => a * (safeCosh(layback / a) - 1) - totalDepth;
    let lo = Math.max(1e-3, layback / 10);
    let hi = Math.max(layback * 10, totalDepth * 10);
    for (let i=0; i<100 && !(f(lo)>0); i++) lo = Math.max(1e-6, lo/1.5);
    for (let i=0; i<100 && !(f(hi)<0); i++) hi *= 1.5;
    if (!(f(lo)>0) || !(f(hi)<0)) throw new Error('Unable to find a valid catenary solution for these inputs.');
    let a = (lo + hi)/2;
    for (let i=0; i<250; i++) {
      a = (lo + hi)/2;
      const fm = f(a);
      if (Math.abs(fm) < 1e-10) break;
      if (fm > 0) lo = a; else hi = a;
    }
    const tBottomN = a * w;
    const length = a * Math.sinh(layback/a);
    const tVesselN = Math.hypot(tBottomN, w * length);
    const bottomTension = tBottomN / TONNE_FORCE_N;
    const onboardTension = tVesselN / TONNE_FORCE_N;
    const angle = Math.atan(Math.sinh(layback/a)) * 180/Math.PI;
    const points = [];
    const n = Math.min(2000, Math.max(100, Math.ceil(layback * 4)));
    for (let i=0; i<=n; i++) {
      const x = layback * i/n;
      points.push({ x, y: -waterDepthLat + a * (Math.cosh(x/a)-1) });
    }
    return { layback, waterDepthLat, waterLevel, waterDepth, chuteHeight: v.chuteHeight, totalDepth, a, length, angle, bottomTension, onboardTension, radiusOK: a >= v.minRadius, tensionOK: tVesselN <= maxTensionN, points };
  }

  function calculateCatenary(v) {
    const laybacks = parsePositiveValues(v.layback, 'Laybacks', 'layback to TDP');
    const waterDepthLats = parsePositiveValues(v.waterDepthLat, 'Water depths from LAT', 'water depth from LAT');
    const waterLevels = parseNumericValues(v.waterLevel, 'Water levels', 'water level');
    const seriesCount = Number(laybacks.length > 1) + Number(waterDepthLats.length > 1) + Number(waterLevels.length > 1);
    if (seriesCount > 1) throw new Error('Use multiple values in only one field: layback, water depth from LAT, or water level.');

    const profiles = [];
    if (waterLevels.length > 1) {
      const baseLayback = laybacks[0];
      const baseWaterDepthLat = waterDepthLats[0];
      const baseWaterLevel = waterLevels[0];
      const baseProfile = calculateCatenaryProfile(v, baseLayback, baseWaterDepthLat, baseWaterLevel);
      waterLevels.forEach((waterLevel, index) => {
        if (index === 0) {
          profiles.push(baseProfile);
          return;
        }
        const recalculatedLayback = baseLayback + (waterLevel - baseWaterLevel);
        if (recalculatedLayback <= 0) throw new Error('Unable to recalculate layback because the water level adjustment gives a layback less than or equal to zero.');
        profiles.push(calculateCatenaryProfile(v, recalculatedLayback, baseWaterDepthLat, waterLevel));
      });
    } else {
      laybacks.forEach(layback => waterDepthLats.forEach(waterDepthLat => waterLevels.forEach(waterLevel => {
        profiles.push(calculateCatenaryProfile(v, layback, waterDepthLat, waterLevel));
      })));
    }

    return { ...v, ...profiles[0], laybacks, waterDepthLats, waterLevels, laybackMode: waterLevels.length > 1 ? 'water-level-shift' : 'input', profiles };
  }

  function fmt(n, decimals=1) { return Number(n).toFixed(decimals); }

  function rows(r) {
    return [
      ['Water depth LAT', `${fmt(r.waterDepthLat,1)} m`],
      ['Water Level', `${fmt(r.waterLevel,1)} m`],
      ['Water Depth to Waterline', `${fmt(r.waterDepth,1)} m`],
      ['Waterline to Chute', `${fmt(r.chuteHeight,1)} m`],
      ['Total Vertical Distance', `${fmt(r.totalDepth,1)} m`],
      ['Layback', `${fmt(r.layback,1)} m`],
      ['Catenary Length', `${fmt(r.length,1)} m`],
      ['Onboard Tension (t)', `${fmt(r.onboardTension,2)} t`],
      ['Onboard Tension (kg)', `${fmt(r.onboardTension*1000,1)} kg`],
      ['Bottom Tension (t)', `${fmt(r.bottomTension,2)} t`],
      ['Bottom Tension (kg)', `${fmt(r.bottomTension*1000,1)} kg`],
      ['Departure Angle', `${fmt(r.angle,1)} ${DEGREE}`],
      ['Effective Bend Radius', `${fmt(r.a,2)} m`],
      ['Bend Radius OK', r.radiusOK ? 'Yes' : 'No'],
      ['Within Tension Limit OK', r.tensionOK ? 'Yes' : 'No']
    ];
  }

  function profileResultRows(r) {
    const profiles = Array.isArray(r.profiles) && r.profiles.length ? r.profiles : [r];
    return profiles.map(profile => [
      fmt(profile.waterDepthLat,1),
      fmt(profile.waterLevel,1),
      fmt(profile.waterDepth,1),
      fmt(profile.chuteHeight,1),
      fmt(profile.totalDepth,1),
      fmt(profile.layback,1),
      fmt(profile.length,1),
      fmt(profile.onboardTension,2),
      fmt(profile.bottomTension,2),
      fmt(profile.angle,1),
      fmt(profile.a,2),
      profile.radiusOK ? 'OK' : 'NOT OK',
      profile.tensionOK ? 'OK' : 'EXCEEDED'
    ]);
  }

  function minProfileValue(r, key) {
    const profiles = Array.isArray(r.profiles) && r.profiles.length ? r.profiles : [r];
    return Math.min(...profiles.map(profile => profile[key]));
  }

  function updateUI(r) {
    const minBottomTension = minProfileValue(r, 'bottomTension');
    const minOnboardTension = minProfileValue(r, 'onboardTension');
    const minLength = minProfileValue(r, 'length');
    const minAngle = minProfileValue(r, 'angle');
    const minRadius = minProfileValue(r, 'a');
    const radiusOK = minRadius >= r.minRadius;
    const tensionOK = minOnboardTension <= r.maxTension;

    $('bottomTension').textContent = `${fmt(minBottomTension,2)} t`;
    $('onboardTension').textContent = `${fmt(minOnboardTension,2)} t`;
    $('length').textContent = `${fmt(minLength,1)} m`;
    $('angle').textContent = `${fmt(minAngle,1)}${DEGREE}`;
    setPill($('radiusCheck'), radiusOK, `Bend radius: ${radiusOK ? 'OK' : 'NOT OK'} (${fmt(minRadius,2)} m)`);
    setPill($('tensionCheck'), tensionOK, `Tension limit: ${tensionOK ? 'OK' : 'EXCEEDED'} (${fmt(minOnboardTension,2)} / ${fmt(r.maxTension,1)} t)`);
    $('resultTableHead').innerHTML = '<tr><th>Water depth LAT<span class="table-unit">m</span></th><th>Water level<span class="table-unit">m</span></th><th>Water depth WL<span class="table-unit">m</span></th><th>Waterline to chute<span class="table-unit">m</span></th><th>Total vertical distance<span class="table-unit">m</span></th><th>Layback<span class="table-unit">m</span></th><th>Catenary length<span class="table-unit">m</span></th><th>Onboard tension<span class="table-unit">t</span></th><th>Bottom tension<span class="table-unit">t</span></th><th>Departure angle<span class="table-unit">deg</span></th><th>Bend radius<span class="table-unit">m</span></th><th>Radius check</th><th>Tension check</th></tr>';
    $('resultTable').innerHTML = profileResultRows(r).map(row => `<tr>${row.map((value, index) => `<td${index >= 11 ? ' class="result-check-cell"' : ''}>${value}</td>`).join('')}</tr>`).join('');
    drawChart(r);
  }

  function setPill(el, ok, text) { el.textContent = text; el.className = `pill ${ok ? 'ok' : 'bad'}`; }

  function drawChart(r) {
    const canvas = $('chart');
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.max(1, Math.round(rect.width*dpr));
    canvas.height = Math.max(1, Math.round(rect.height*dpr));
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr,0,0,dpr,0,0);
    const W=rect.width, H=rect.height;
    const m={l:68,r:25,t:40,b:58};
    const pw=W-m.l-m.r, ph=H-m.t-m.b;
    const profiles = Array.isArray(r.profiles) && r.profiles.length ? r.profiles : [r];
    const colors = ['#29378A','#007C89','#C55300','#6D4BC3','#167A3D','#B12A5B','#5F6B00'];
    const maxLayback=Math.max(1,...profiles.map(profile => profile.layback));
    const xMin=0;
    const xMax=maxLayback * 1.08;
    const yDataMin=Math.min(...profiles.map(profile => -profile.waterDepthLat));
    const yDataMax=Math.max(...profiles.map(profile => profile.waterLevel + profile.chuteHeight));
    const yPadding=Math.max(1, (yDataMax - yDataMin) * .06);
    const yMin=yDataMin - yPadding;
    const yMax=yDataMax + yPadding;
    const xRange=Math.max(1, xMax - xMin);
    const yRange=Math.max(1, yMax - yMin);
    const scale=Math.min(pw / xRange, ph / yRange);
    const plotW=xRange * scale;
    const plotH=yRange * scale;
    const plotLeft=m.l + (pw - plotW) / 2;
    const plotTop=m.t + (ph - plotH) / 2;
    const plotRight=plotLeft + plotW;
    const plotBottom=plotTop + plotH;
    const plotOffsetX=profile => r.laybackMode === 'water-level-shift' ? maxLayback - profile.layback : 0;
    const plotPoint=(profile, point) => ({ x: point.x + plotOffsetX(profile), y: point.y });
    const X=x=>plotLeft+(x-xMin)*scale;
    const Y=y=>plotTop+(yMax-y)*scale;
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,W,H);
    const maxWaterLevel = Math.max(...profiles.map(profile => profile.waterLevel));
    const maxWaterDepthLat = Math.max(...profiles.map(profile => profile.waterDepthLat));
    ctx.fillStyle='#F3F5FB'; ctx.fillRect(plotLeft,Y(maxWaterLevel),plotW,Y(-maxWaterDepthLat)-Y(maxWaterLevel));
    ctx.strokeStyle='#E1E3EB'; ctx.lineWidth=1;
    ctx.fillStyle='#747680'; ctx.font='12px Arial';
    ctx.textAlign='right'; ctx.textBaseline='middle';
    const yStep = yRange > 35 ? 10 : 5;
    const firstYTick = Math.ceil(yMin / yStep) * yStep;
    for(let y=firstYTick; y<=yMax + 1e-9; y+=yStep){
      ctx.beginPath();ctx.moveTo(plotLeft,Y(y));ctx.lineTo(plotRight,Y(y));ctx.stroke();
      ctx.fillText(`${y.toFixed(0)} m`,plotLeft-9,Y(y));
    }
    ctx.textAlign='center';ctx.textBaseline='top';
    const xStep = xRange > 40 ? 10 : 5;
    for(let x=0; x<=xMax + 1e-9; x+=xStep){
      ctx.beginPath();ctx.moveTo(X(x),plotTop);ctx.lineTo(X(x),plotBottom);ctx.stroke();
      ctx.fillText(`${x.toFixed(xRange < 12 ? 1 : 0)} m`,X(x),plotBottom+9);
    }
    ctx.strokeStyle='#A5A8B2';ctx.lineWidth=1.2;
    ctx.beginPath();ctx.moveTo(plotLeft,plotTop);ctx.lineTo(plotLeft,plotBottom);ctx.lineTo(plotRight,plotBottom);ctx.stroke();
    profiles.forEach((profile, profileIndex) => {
      ctx.strokeStyle=colors[profileIndex % colors.length];ctx.lineWidth=profileIndex === 0 ? 4 : 2.5;
      ctx.beginPath();
      profile.points.forEach((p,i)=>{
        const plotted = plotPoint(profile, p);
        i?ctx.lineTo(X(plotted.x),Y(plotted.y)):ctx.moveTo(X(plotted.x),Y(plotted.y));
      });
      ctx.stroke();
    });
    profiles.forEach((profile, profileIndex) => {
      const tdpPoint = plotPoint(profile, profile.points[0]);
      ctx.beginPath();ctx.arc(X(tdpPoint.x),Y(tdpPoint.y),5,0,Math.PI*2);
      ctx.fillStyle=profileIndex === 0 ? '#FFF000' : '#FFFFFF';
      ctx.fill();ctx.strokeStyle=colors[profileIndex % colors.length];ctx.lineWidth=2;ctx.stroke();
    });
    const tdp=plotPoint(profiles[0], profiles[0].points[0]);
    const chute=plotPoint(profiles[0], profiles[0].points[profiles[0].points.length-1]);
    ctx.beginPath();ctx.arc(X(chute.x),Y(chute.y),6,0,Math.PI*2);ctx.fillStyle='#FFF000';ctx.fill();ctx.strokeStyle='#29378A';ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle='#29378A';ctx.font='700 12px Arial';ctx.textAlign='left';ctx.textBaseline='bottom';
    ctx.fillText('TDP',X(tdp.x)+8,Y(tdp.y)-5);
    ctx.textAlign='right';ctx.fillText('Chute',X(chute.x)-8,Y(chute.y)-7);
    [...new Set(profiles.map(profile => profile.waterDepthLat))].forEach(waterDepthLat => {
      ctx.strokeStyle='#9A9A9A';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(plotLeft,Y(-waterDepthLat));ctx.lineTo(plotRight,Y(-waterDepthLat));ctx.stroke();
    });
    [...new Set(profiles.map(profile => profile.waterLevel))].forEach(waterLevel => {
      ctx.strokeStyle='#8DBCCB';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(plotLeft,Y(waterLevel));ctx.lineTo(plotRight,Y(waterLevel));ctx.stroke();
    });
    if (profiles.length > 1) {
      const legendW=98, legendH=24 + profiles.length * 18;
      const legendX=Math.min(plotRight - legendW - 10, X(maxLayback) - legendW - 8);
      const legendY=Math.max(plotTop + 10, plotBottom - legendH - 14);
      ctx.fillStyle='rgba(255,255,255,.9)';ctx.fillRect(legendX,legendY,legendW,legendH);
      ctx.strokeStyle='#D9DCE6';ctx.lineWidth=1;ctx.strokeRect(legendX,legendY,legendW,legendH);
      ctx.fillStyle='#29378A';ctx.font='700 11px Arial';ctx.textAlign='left';ctx.textBaseline='top';ctx.fillText('Profiles',legendX+10,legendY+8);
      profiles.forEach((profile, profileIndex) => {
        const y=legendY+25+profileIndex*18;
        ctx.strokeStyle=colors[profileIndex % colors.length];ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(legendX+10,y+5);ctx.lineTo(legendX+30,y+5);ctx.stroke();
        ctx.fillStyle='#29378A';ctx.font='11px Arial';ctx.fillText(`${fmt(profile.waterLevel,0)} m WL`,legendX+36,y);
      });
    }
    ctx.fillStyle='#29378A';ctx.font='800 17px Arial';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('Catenary Profile',W/2,10);
    ctx.font='13px Arial';ctx.fillText('Horizontal position (m)',m.l+pw/2,H-25);
    ctx.save();ctx.translate(18,m.t+ph/2);ctx.rotate(-Math.PI/2);ctx.fillText('Vertical position (m)',0,0);ctx.restore();
  }

  function calculate() {
    try {
      $('error').style.display='none';
      latest=calculateCatenary(readInputs());
      updateUI(latest);
    } catch(e) {
      $('error').textContent=e.message;
      $('error').style.display='block';
    }
  }

  function getInputState() { const state = {}; for (const key of inputKeys) state[key] = $(key).value; return state; }
  function sameState(a, b) { return inputKeys.every(key => a && b && a[key] === b[key]); }
  function applyInputState(state) { for (const key of inputKeys) $(key).value = state[key] ?? ''; calculate(); }
  function updateHistoryButtons() { $('undoBtn').disabled = historyIndex <= 0; $('redoBtn').disabled = historyIndex >= history.length - 1; }
  function recordHistory() {
    const state = getInputState();
    if (sameState(state, history[historyIndex])) return;
    history = history.slice(0, historyIndex + 1);
    history.push(state);
    historyIndex = history.length - 1;
    updateHistoryButtons();
  }

  function download(filename, content, type) {
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([content],{type}));a.download=filename;a.click();URL.revokeObjectURL(a.href);
  }

  function csvEscape(value) { return `"${String(value).replaceAll('"','""')}"`; }
  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
    }[char]));
  }

  function projectMeta() {
    return {
      projectName: $('projectNameInput').value.trim(),
      projectNumber: $('projectNumberInput').value.trim(),
      revision: $('revisionInput').value.trim(),
      author: $('authorInput').value.trim()
    };
  }

  function reportFileTitle(meta, fallback) {
    return [meta.projectNumber, meta.projectName, meta.revision]
      .map(value => String(value ?? '').trim())
      .filter(Boolean)
      .join(' - ') || fallback;
  }

  function generatePdfReport() {
    let report;
    try {
      $('error').style.display='none';
      report = calculateCatenary(readInputs());
      latest = report;
      updateUI(report);
    } catch(e) {
      $('error').textContent=e.message;
      $('error').style.display='block';
      return;
    }

    const meta = projectMeta();
    const pdfTitle = reportFileTitle(meta, 'Catenary Calculation Report');
    const generated = new Date().toISOString().slice(0, 10);
    const chartImage = $('chart').toDataURL('image/png');
    const logoHtml = document.querySelector('.brand-logo')?.outerHTML ?? '';
    const profiles = Array.isArray(report.profiles) && report.profiles.length ? report.profiles : [report];
    const summary = [
      ['Bottom tension', `${fmt(minProfileValue(report, 'bottomTension'),2)} t`],
      ['Onboard tension', `${fmt(minProfileValue(report, 'onboardTension'),2)} t`],
      ['Catenary length', `${fmt(minProfileValue(report, 'length'),1)} m`],
      ['Departure angle', `${fmt(minProfileValue(report, 'angle'),1)} deg`]
    ];
    const inputsTable = [
      ['Wet weight of cable', `${fmt(report.wetWeight,1)} kg/m`],
      ['Minimum bending radius', `${fmt(report.minRadius,1)} m`],
      ['Maximum cable tension', `${fmt(report.maxTension,1)} t`],
      ['Layback to TDP', $('layback').value],
      ['Water depth from LAT', $('waterDepthLat').value],
      ['Water level', $('waterLevel').value],
      ['Waterline to chute', `${fmt(report.chuteHeight,1)} m`]
    ];
    const resultHeaders = ['Water depth LAT [m]', 'Water level [m]', 'Water depth WL [m]', 'Waterline to chute [m]', 'Total vertical distance [m]', 'Layback [m]', 'Catenary length [m]', 'Onboard tension [t]', 'Bottom tension [t]', 'Departure angle [deg]', 'Bend radius [m]', 'Radius check', 'Tension check'];
    const resultRows = profileResultRows(report);
    const reportWindow = window.open('', '_blank');
    if (!reportWindow) {
      alert('Please allow pop-ups to generate the PDF report.');
      return;
    }

    reportWindow.document.write(`
      <!doctype html>
      <html>
        <head>
          <title>${escapeHtml(pdfTitle)}</title>
          <style>
            * { box-sizing: border-box; }
            body { font-family: Calibri, Arial, sans-serif; color: #000; margin: 18px; background: #d9d9d9; }
            .page { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 14mm; background: #fff; }
            .title { position: relative; display: flex; align-items: center; justify-content: center; min-height: 82px; background: #142968; color: #fff; font-size: 20px; font-weight: 700; text-align: center; padding: 12px 80px; }
            .report-logo-wrap { position: absolute; left: 18px; top: 9px; display: flex; align-items: center; justify-content: center; width: 54px; height: 64px; background: #fff; }
            .report-logo-wrap img { width: 34px; height: auto; display: block; }
            table { width: 100%; border-collapse: collapse; table-layout: fixed; }
            th, td { border: 1px solid #d0d0d0; padding: 4px 5px; vertical-align: middle; overflow-wrap: anywhere; font-size: 9px; }
            th { background: #142968; color: #fff; font-weight: 700; text-align: center; }
            td { background: #f2f2f2; text-align: center; }
            .meta { margin-top: 8px; }
            .meta th { width: 22%; background: #d9d9d9; color: #000; text-align: left; }
            .meta td { text-align: left; }
            h2 { margin: 10px 0 5px; color: #142968; font-size: 14px; }
            .summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 10px 0; }
            .card { border: 1px solid #d0d0d0; background: #f2f2f2; padding: 8px; min-height: 48px; }
            .card span { display: block; color: #555; font-size: 8px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
            .card strong { display: block; margin-top: 5px; color: #142968; font-size: 15px; }
            .chart { display: block; width: 100%; max-height: 280px; object-fit: contain; border: 1px solid #d0d0d0; margin-top: 5px; }
            .note { margin-top: 8px; color: #555; font-size: 8px; }
            .ok { color: #142968; font-weight: 700; }
            .bad { color: #c9221c; font-weight: 700; }
            @page { size: A4 portrait; margin: 10mm; }
            @media print { body { margin: 0; background: #fff; } .page { width: auto; min-height: auto; padding: 0; } }
          </style>
        </head>
        <body>
          <div class="page">
            <div class="title"><span class="report-logo-wrap">${logoHtml}</span><span>Cable Catenary Calculation Report</span></div>
            <table class="meta">
              <tr><th>Project</th><td>${escapeHtml(meta.projectName)}</td><th>Project number</th><td>${escapeHtml(meta.projectNumber)}</td></tr>
              <tr><th>Revision</th><td>${escapeHtml(meta.revision)}</td><th>Date</th><td>${escapeHtml(generated)}</td></tr>
              <tr><th>Originator</th><td>${escapeHtml(meta.author)}</td><th>Profiles</th><td>${profiles.length}</td></tr>
            </table>
            <div class="summary">
              ${summary.map(([label, value]) => `<div class="card"><span>${escapeHtml(label)}</span><strong>${escapeHtml(value)}</strong></div>`).join('')}
            </div>
            <h2>Input Values</h2>
            <table>
              <tbody>${inputsTable.map(([label, value]) => `<tr><th>${escapeHtml(label)}</th><td>${escapeHtml(value)}</td></tr>`).join('')}</tbody>
            </table>
            <h2>Catenary Profile</h2>
            <img class="chart" src="${chartImage}" alt="Catenary profile">
            <h2>Calculation Result</h2>
            <table>
              <thead><tr>${resultHeaders.map(header => `<th>${escapeHtml(header)}</th>`).join('')}</tr></thead>
              <tbody>${resultRows.map(row => `<tr>${row.map((value, index) => `<td class="${index >= 11 ? (String(value).includes('OK') ? 'ok' : 'bad') : ''}">${escapeHtml(value)}</td>`).join('')}</tr>`).join('')}</tbody>
            </table>
            <p class="note">Static ideal catenary calculation. Dynamic effects, drag, cable stiffness, seabed interaction, dynamic amplification and installation transients are excluded.</p>
          </div>
          <script>window.addEventListener('load', () => window.print());<\/script>
        </body>
      </html>
    `);
    reportWindow.document.close();
  }

  function parseCsv(text) {
    const rows = []; let row = []; let cell = ''; let quoted = false;
    for (let i=0; i<text.length; i++) {
      const ch = text[i];
      if (quoted) { if (ch === '"' && text[i+1] === '"') { cell += '"'; i++; } else if (ch === '"') { quoted = false; } else { cell += ch; } }
      else if (ch === '"') { quoted = true; } else if (ch === ',') { row.push(cell); cell = ''; } else if (ch === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; } else if (ch !== '\r') { cell += ch; }
    }
    row.push(cell); rows.push(row);
    return rows.filter(r => r.some(value => value !== ''));
  }

  $('saveProjectBtn').addEventListener('click',()=>{
    const state = getInputState();
    const csv = 'Parameter,Value\n' + inputKeys.map(key => [key, state[key]].map(csvEscape).join(',')).join('\n');
    download('catenary_project.csv', csv, 'text/csv');
  });

  $('generateReportBtn').addEventListener('click',generatePdfReport);
  $('loadProjectBtn').addEventListener('click',()=>$('projectFileInput').click());
  $('projectFileInput').addEventListener('change',event=>{
    const file = event.target.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = Object.fromEntries(parseCsv(String(reader.result)).slice(1));
        for (const key of numericEngineeringKeys) $(key).value = data[key] ?? defaults[key];
        for (const key of Object.keys(textDefaults)) $(key).value = data[key] ?? (key === 'waterDepthLat' ? data.waterDepth : textDefaults[key]);
        for (const key of projectKeys) $(key).value = data[key] ?? '';
        recordHistory(); calculate();
      } catch(e) { $('error').textContent = e.message; $('error').style.display = 'block'; } finally { event.target.value = ''; }
    };
    reader.readAsText(file);
  });

  $('undoBtn').addEventListener('click',()=>{ if (historyIndex <= 0) return; historyIndex--; applyInputState(history[historyIndex]); updateHistoryButtons(); });
  $('redoBtn').addEventListener('click',()=>{ if (historyIndex >= history.length - 1) return; historyIndex++; applyInputState(history[historyIndex]); updateHistoryButtons(); });
  document.querySelectorAll('.tab-button').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.tab-button').forEach(item => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      document.querySelectorAll('.tab-panel').forEach(panel => {
        panel.classList.toggle('is-active', panel.id === button.dataset.tabTarget);
      });
    });
  });
  inputs.forEach(el=>el.addEventListener('input',()=>{recordHistory();calculate();}));
  projectInputs.forEach(el=>el.addEventListener('input',()=>{recordHistory();}));
  window.addEventListener('resize',()=>latest&&drawChart(latest));
  recordHistory();
  calculate();
})();
</script>
</body>
</html>
