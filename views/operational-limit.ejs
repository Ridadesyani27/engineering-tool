<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>N-Sea Engineering Tools</title>
  <link rel="stylesheet" href="nseastyle.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,300;0,400;0,700;0,900;1,700&display=swap" rel="stylesheet">
</head>
<body class="is-operational-limit">
<header>
  <div class="brand-row">
    <div class="brand-left">
      <div class="brand-logo-wrap"><img class="brand-logo" src="data:image/svg+xml;base64," alt="N-Sea logo"></div>
      <div>
        <div class="project-label">Cable Engineering Tools</div>
        <div class="project-sub-label"><a class="dashboard-link" href="/">Back to dashboard</a></div>
      </div>
    </div>
    <div class="brand-title">
      <div>
        <h1>Operational Limit Assessment</h1>
        <p>This tool will automatically calculate the operational limit based on the alpha factor</p>
      </div>
    </div>
  </div>
</header>

<main class="app-shell">
  <aside class="panel project-sidebar">
    <h2>Project Input</h2>

    <label class="field">
      <span>Project Name</span>
      <input id="projectNameInput" type="text">
    </label>

    <label class="field">
      <span>Project Number</span>
      <input id="projectNumberInput" type="text">
    </label>

    <label class="field">
      <span>Revision</span>
      <input id="revisionInput" type="text">
    </label>

    <div class="sidebar-actions">
      <button id="generatePdfButton" class="primary-action" type="button">Generate Report PDF</button>
      <button id="saveProjectButton" class="secondary-action" type="button">Save Project</button>
      <button id="loadProjectButton" class="secondary-action" type="button">Load Project</button>
      <a class="manual-action" href="https://nseagroupbv.sharepoint.com/sites/SubseaCablesDept/_layouts/15/guestaccess.aspx?share=IQA1NejbRB_3Q4VbOZIhre4FAXLRwFvRYBKQAakUvbrdoMA&e=h0OT1V" target="_blank" rel="noopener">Manual</a>
      <button id="undoButton" class="secondary-action" type="button">Undo</button>
      <button id="redoButton" class="secondary-action" type="button">Redo</button>
      <input id="loadProjectInput" type="file" accept=".csv,text/csv" hidden>
    </div>
  </aside>

  <section class="operation-workspace">
    <section class="panel operation-toolbar">
      <div class="category-tools">
        <button id="addLimitCategoryButton" class="add-limit-category" type="button">Add operational limit category</button>
        <div id="limitCategoryControls" class="limit-category-controls"></div>
      </div>

      <label class="field wind-field">
        <span>Wind α-factor category</span>
        <select id="windCategorySelect"></select>
      </label>

      <label class="field twf-field">
        <span title="Interval between consecutive weather forecast">Twf [hrs]</span>
        <input id="twfInput" type="number" min="0" step="0.5">
      </label>
    </section>

    <section id="activitiesContainer" class="activities-stack" aria-label="Operational limit activities"></section>
  </section>
</main>

<footer>
  <div class="footer-inner">
    <span class="footer-brand">N-Sea Engineering Tools</span> - Built by Rida. Still evolving, already surprisingly useful. Found a bug or have an idea to make it even better?
    <a class="footer-contact" href="<%= mailtoLink %>">Drop me a line and let me know.</a>
  </div>
</footer>

<script>
window.OPERATION_LIMIT_DATA = <%- operationLimitData %>;
</script>
<script src="operational-limit.js?v=<%= scriptVersion %>"></script>
</body>
</html>
