function collectFields() {
  return Array.from(new FormData(form).entries())
    .filter(([name]) => name !== 'active_tab')
    .map(([name, value]) => ({ name, value }));
}

function fieldValue(fields, name) {
  return fields.find(field => field.name === name)?.value || '';
}

function draftTitle(fields) {
  const parts = [fieldValue(fields, 'project_number').trim(), fieldValue(fields, 'project').trim()].filter(Boolean);
  const revision = fieldValue(fields, 'revision').trim();
  if (revision) parts.push(`Rev ${revision}`);
  return parts.join(' - ') || 'Untitled calculation';
}

function reportFileTitle(fields) {
  const parts = [
    fieldValue(fields, 'project_number').trim(),
    fieldValue(fields, 'project').trim(),
    fieldValue(fields, 'revision').trim()
  ].filter(Boolean);
  return parts.join(' - ') || 'Carousel Stowage Calculation Report';
}

function safeFileBase(value, fallback) {
  return String(value || fallback)
    .trim()
    .replace(/[<>:"/\\|?*\x00-\x1F]+/g, ' ')
    .replace(/\s+/g, ' ')
    .replace(/[. ]+$/g, '')
    || fallback;
}

function csvEscape(value) {
  return `"${String(value ?? '').replaceAll('"', '""')}"`;
}

function fieldsToCsv(fields) {
  return [
    ['Field', 'Value'].map(csvEscape).join(','),
    ...fields.map(field => [field.name, field.value].map(csvEscape).join(','))
  ].join('\n');
}

function parseCsvRows(text) {
  const rows = [];
  let row = [];
  let cell = '';
  let quoted = false;
  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];
    if (quoted) {
      if (char === '"' && text[index + 1] === '"') {
        cell += '"';
        index += 1;
      } else if (char === '"') {
        quoted = false;
      } else {
        cell += char;
      }
    } else if (char === '"') {
      quoted = true;
    } else if (char === ',') {
      row.push(cell);
      cell = '';
    } else if (char === '\n') {
      row.push(cell);
      rows.push(row);
      row = [];
      cell = '';
    } else if (char !== '\r') {
      cell += char;
    }
  }
  row.push(cell);
  rows.push(row);
  return rows.filter(item => item.some(value => value !== ''));
}

function csvToFields(text) {
  const rows = parseCsvRows(text);
  if (!rows.length) return [];
  const header = rows[0].map(value => String(value).trim().toLowerCase());
  if (header[0] === 'field' && header[1] === 'value') {
    return rows.slice(1)
      .filter(row => row[0])
      .map(row => ({ name: row[0], value: row[1] ?? '' }));
  }
  if (header[0] === 'parameter' && header[1] === 'value') {
    return rows.slice(1)
      .filter(row => row[0])
      .map(row => ({ name: row[0], value: row[1] ?? '' }));
  }
  throw new Error('Project CSV must have Field and Value columns.');
}

function groupedRowsFromFields(fields, prefix) {
  const rows = {};
  fields.forEach(({ name, value }) => {
    const match = name.match(new RegExp(`^${prefix}\\[(\\d+)\\]\\[(.+)\\]$`));
    if (!match) return;
    rows[match[1]] = rows[match[1]] || {};
    rows[match[1]][match[2]] = value;
  });
  return Object.keys(rows).sort((a, b) => Number(a) - Number(b)).map(key => rows[key]);
}

function hasGroupedFields(fields, prefix) {
  return fields.some(({ name }) => new RegExp(`^${prefix}\\[\\d+\\]\\[`).test(name));
}

const autosavedDraftStorageKey = 'carouselStowageAutosavedDraft';
const savedCalculationsStorageKey = 'carouselStowageSavedCalculations';
const maxSavedCalculations = 10;
let autosaveTimer = null;
let autosavePending = false;

function storageGet(key) {
  try {
    const storage = globalThis.localStorage;
    if (storage) return storage.getItem(key);
  } catch {
    // Fall through to cookie storage.
  }
  const cookie = document.cookie.split('; ').find(item => item.startsWith(`${encodeURIComponent(key)}=`));
  return cookie ? decodeURIComponent(cookie.split('=').slice(1).join('=')) : null;
}

function storageSet(key, value) {
  try {
    const storage = globalThis.localStorage;
    if (storage) {
      storage.setItem(key, value);
      return;
    }
  } catch {
    // Fall through to cookie storage.
  }
  document.cookie = `${encodeURIComponent(key)}=${encodeURIComponent(value)}; max-age=2592000; path=/; samesite=lax`;
}

function storageRemove(key) {
  try {
    const storage = globalThis.localStorage;
    if (storage) storage.removeItem(key);
  } catch {
    // Fall through to cookie storage.
  }
  document.cookie = `${encodeURIComponent(key)}=; max-age=0; path=/; samesite=lax`;
}

function readAutosavedDraft() {
  try {
    return JSON.parse(storageGet(autosavedDraftStorageKey) || 'null');
  } catch {
    return null;
  }
}

function readSavedCalculations() {
  try {
    const saved = JSON.parse(storageGet(savedCalculationsStorageKey) || '[]');
    return Array.isArray(saved) ? saved.filter(item => Array.isArray(item?.fields)) : [];
  } catch {
    return [];
  }
}

function writeSavedCalculations(savedCalculations) {
  storageSet(savedCalculationsStorageKey, JSON.stringify(savedCalculations.slice(0, maxSavedCalculations)));
}

function calculationSignature(fields) {
  return JSON.stringify(fields);
}

function calculationRecord(fields, status = 'draft', resultSnapshot = null) {
  const record = {
    schemaVersion: 2,
    savedAt: new Date().toISOString(),
    title: draftTitle(fields),
    status,
    fields
  };
  if (resultSnapshot) record.result = resultSnapshot;
  return record;
}

function renderRecentQueries() {
  const list = document.getElementById('recentQueriesList');
  if (!list) return;
  const draft = readAutosavedDraft();
  const savedCalculations = readSavedCalculations();
  const draftIsAlsoLatestSaved = draft?.fields && savedCalculations.some(saved =>
    calculationSignature(saved.fields) === calculationSignature(draft.fields)
  );
  const items = [
    ...savedCalculations.map((saved, index) => ({ ...saved, kind: 'saved', index })),
    ...(draft?.fields && !draftIsAlsoLatestSaved ? [{ ...draft, kind: 'draft' }] : [])
  ];

  if (!items.length) {
    list.innerHTML = '<div class="recent-query-empty">No saved calculations yet.</div>';
    return;
  }
  list.innerHTML = items.map(item => `
    <div class="recent-query-item" data-query-kind="${escapeHtml(item.kind)}" ${item.kind === 'saved' ? `data-saved-index="${item.index}"` : ''}>
      <div>
        <div class="recent-query-title">${item.kind === 'saved' ? 'Saved Calculation' : 'Autosaved Draft'}: ${escapeHtml(draftTitle(item.fields))}</div>
        <div class="recent-query-meta">${escapeHtml(item.savedAt ? new Date(item.savedAt).toLocaleString() : '')}</div>
      </div>
      <div class="recent-query-actions">
        <button class="secondary recent-query-load" type="button">Restore</button>
        <button class="danger recent-query-delete" type="button">Delete</button>
      </div>
    </div>
  `).join('');
}

function saveAutosavedDraft() {
  if (!form) return;
  const fields = collectFields();
  try {
    storageSet(autosavedDraftStorageKey, JSON.stringify(calculationRecord(fields, 'draft')));
    autosavePending = false;
    renderRecentQueries();
  } catch {
    // Browser storage can be unavailable in private or restricted sessions.
  }
}

function scheduleAutosaveDraft() {
  autosavePending = true;
  window.clearTimeout(autosaveTimer);
  autosaveTimer = window.setTimeout(saveAutosavedDraft, 350);
}

function flushAutosaveDraft(force = false) {
  window.clearTimeout(autosaveTimer);
  autosaveTimer = null;
  if (force || autosavePending) saveAutosavedDraft();
}

function saveCalculationRun() {
  if (!form) return;
  const fields = collectFields();
  try {
    const record = calculationRecord(fields, 'submitted', carouselResultSnapshot);
    const recordSignature = calculationSignature(fields);
    const savedCalculations = readSavedCalculations()
      .filter(saved => calculationSignature(saved.fields) !== recordSignature);
    writeSavedCalculations([record, ...savedCalculations]);
    storageSet(autosavedDraftStorageKey, JSON.stringify(record));
    autosavePending = false;
    renderRecentQueries();
  } catch {
    // Browser storage can be unavailable in private or restricted sessions.
  }
}

function applyDraftFields(fields, options = {}) {
  const preserveMissingGroups = Boolean(options.preserveMissingGroups);
  const hasCustomVessels = hasGroupedFields(fields, 'custom_vessels');
  const hasCableTypes = hasGroupedFields(fields, 'cable_types');
  const hasCables = hasGroupedFields(fields, 'cables');

  if (hasCustomVessels || !preserveMissingGroups) {
    const store = document.getElementById('customVesselStore');
    if (store) store.innerHTML = '';
    groupedRowsFromFields(fields, 'custom_vessels').forEach(addStoredCustomVesselRow);
  }

  if (hasCableTypes || !preserveMissingGroups) {
    document.querySelector('#cableTypeTable tbody').innerHTML = '';
    groupedRowsFromFields(fields, 'cable_types').forEach(addCableTypeRow);
  }

  if (hasCables || !preserveMissingGroups) {
    document.querySelector('#cableRows tbody').innerHTML = '';
    groupedRowsFromFields(fields, 'cables').forEach(addCableRow);
  }

  fields.forEach(({ name, value }) => {
    if (name.startsWith('custom_vessels[') || name.startsWith('cable_types[') || name.startsWith('cables[')) return;
    const field = form.elements[name];
    if (field && typeof field.value !== 'undefined') field.value = value;
  });
  refreshCablePartitionOptions();
  scheduleAutosaveDraft();
}

function clearAutosavedDraft() {
  storageRemove(autosavedDraftStorageKey);
  storageRemove(savedCalculationsStorageKey);
  renderRecentQueries();
}

document.getElementById('addCableTypeRow')?.addEventListener('click', () => {
  addCableTypeRow();
  scheduleAutosaveDraft();
});
document.getElementById('addVesselData')?.addEventListener('click', openCustomVesselEditor);
document.getElementById('customCarouselMode')?.addEventListener('change', renderCustomVesselEditorRows);
document.getElementById('saveCustomVessel')?.addEventListener('click', saveCustomVesselFromEditor);
document.getElementById('cancelCustomVessel')?.addEventListener('click', () => setVesselEditorOpen(false));
['vessel', 'carousel_mode', 'partition_extension'].forEach(id => {
  document.getElementById(id)?.addEventListener('change', () => submitCarouselForm('vessel'));
});
document.getElementById('stowing_factor')?.addEventListener('change', () => submitCarouselForm('vessel'));
document.getElementById('addCableRow')?.addEventListener('click', () => {
  addCableRow();
  scheduleAutosaveDraft();
});
document.getElementById('clearRecentQueries')?.addEventListener('click', clearAutosavedDraft);
document.addEventListener('click', event => {
  if (event.target.closest('.remove-cable-type-row')) {
    event.target.closest('tr')?.remove();
    scheduleAutosaveDraft();
  }
  if (event.target.closest('.remove-cable-row')) {
    event.target.closest('tr')?.remove();
    scheduleAutosaveDraft();
  }
  if (event.target.closest('.recent-query-load')) {
    const item = event.target.closest('.recent-query-item');
    const savedIndex = Number(item?.dataset.savedIndex);
    const saved = item?.dataset.queryKind === 'saved' ? readSavedCalculations()[savedIndex] : null;
    const draft = item?.dataset.queryKind === 'draft' ? readAutosavedDraft() : null;
    const calculation = saved || draft;
    if (calculation?.fields) applyDraftFields(calculation.fields, { preserveMissingGroups: !calculation.schemaVersion });
    if (item?.dataset.queryKind === 'saved') {
      window.setTimeout(() => form?.requestSubmit(document.querySelector('.output-actions button.primary')), 0);
    } else {
      document.getElementById('tab-project')?.click();
    }
  }
  if (event.target.closest('.recent-query-delete')) {
    const item = event.target.closest('.recent-query-item');
    if (item?.dataset.queryKind === 'saved') {
      const savedIndex = Number(item.dataset.savedIndex);
      const savedCalculations = readSavedCalculations().filter((_, index) => index !== savedIndex);
      writeSavedCalculations(savedCalculations);
      renderRecentQueries();
    }
    if (item?.dataset.queryKind === 'draft') {
      storageRemove(autosavedDraftStorageKey);
      renderRecentQueries();
    }
  }
});
document.addEventListener('input', event => {
  if (event.target.matches('#cableTypeTable input[type="color"]')) refreshCableColors();
  if (event.target.matches('#customVesselStore input[name$="[partition]"]')) refreshCablePartitionOptions();
  if (event.target.matches('#customVesselStore input[name$="[vessel_name]"], #customVesselStore input[name$="[carousel_mode]"]')) refreshCustomVesselOptions();
});
form?.addEventListener('change', event => {
  if (event.target.matches('#cableRows select[name$="[type]"]')) refreshCableColors();
});
form?.addEventListener('input', scheduleAutosaveDraft);
form?.addEventListener('change', scheduleAutosaveDraft);
form?.addEventListener('submit', () => flushAutosaveDraft(true));
window.addEventListener('pagehide', () => flushAutosaveDraft(false));
renderRecentQueries();
if (carouselSubmitted) saveCalculationRun();

document.getElementById('saveProject')?.addEventListener('click', () => {
  const link = document.createElement('a');
  const fields = collectFields();
  link.href = URL.createObjectURL(new Blob([fieldsToCsv(fields)], { type: 'text/csv' }));
  link.download = `${safeFileBase(reportFileTitle(fields), 'carousel_stowage_project')}.csv`;
  link.click();
  URL.revokeObjectURL(link.href);
});
document.getElementById('loadProject')?.addEventListener('click', () => document.getElementById('loadProjectFile')?.click());
function createPdfReport() {
  const reportTitle = reportFileTitle(collectFields());
  const sourceLogo = document.querySelector('.brand-logo');
  const reportLogo = document.getElementById('pdfReportLogo');
  if (sourceLogo instanceof HTMLImageElement && reportLogo instanceof HTMLImageElement) {
    reportLogo.src = sourceLogo.src;
  }
  const report = document.querySelector('.pdf-report');
  const reportWindow = window.open('', '_blank');
  if (!reportWindow) {
    alert('Please allow pop-ups to generate the PDF report.');
    return;
  }
  reportWindow.document.write(`
    <!doctype html>
    <html>
      <head>
        <title>${escapeHtml(reportTitle)}</title>
        <link rel="stylesheet" href="/nseastyle.css">
        <link rel="stylesheet" href="/carousel.css">
        <style>
          body { margin: 0; background: #d9d9d9; }
          .pdf-report { display: block !important; }
          .pdf-report-sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 10mm;
            background: #FFFFFF;
            box-sizing: border-box;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
          }
          @page { size: A4 portrait; margin: 0; }
          @media print {
            body { margin: 0; background: #FFFFFF; }
            .pdf-report-sheet { margin: 0; min-height: auto; }
          }
        </style>
      </head>
      <body>
        ${report ? report.outerHTML : '<p>Report is not available. Run the calculation first.</p>'}
        <script>window.addEventListener('load', () => window.print());<\/script>
      </body>
    </html>
  `);
  reportWindow.document.close();
}

document.getElementById('createPdf')?.addEventListener('click', createPdfReport);
document.getElementById('loadProjectFile')?.addEventListener('change', event => {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const text = String(reader.result);
      if (file.name.toLowerCase().endsWith('.json') || text.trim().startsWith('{')) {
        const data = JSON.parse(text);
        if (Array.isArray(data.fields)) {
          applyDraftFields(data.fields, { preserveMissingGroups: !data.schemaVersion });
        } else {
          const fields = [];
          Object.entries(data).forEach(([key, value]) => {
            if (typeof value !== 'object') fields.push({ name: key, value });
          });
          (data.cable_types || []).forEach((type, index) => {
            Object.entries(type).forEach(([key, value]) => fields.push({ name: `cable_types[${index}][${key}]`, value }));
          });
          (data.cables || []).forEach((cable, index) => {
            Object.entries(cable).forEach(([key, value]) => fields.push({ name: `cables[${index}][${key}]`, value }));
          });
          (data.custom_vessels || []).forEach((vessel, index) => {
            Object.entries(vessel).forEach(([key, value]) => fields.push({ name: `custom_vessels[${index}][${key}]`, value }));
          });
          applyDraftFields(fields);
        }
      } else {
        applyDraftFields(csvToFields(text));
      }
      form.submit();
    } catch (error) {
      alert('Unable to load carousel project file.');
    } finally {
      event.target.value = '';
    }
  };
  reader.readAsText(file);
});
</script>
</body>
